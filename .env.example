# Copy to `.env` (gitignored) and fill in. Commands that call a live service load it
# with `uv run --env-file .env ...`; nothing in docgap reads this file itself.

# Anthropic API key for live model calls (the pilot, the baseline, Phase 5). Use a
# key made for docgap, in a workspace with a monthly spend limit.
ANTHROPIC_API_KEY=
