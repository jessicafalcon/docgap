# Local-only Claude Code files
.claude/settings.local.json
.claude/private-terms.local

# OS
.DS_Store

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Secrets and local state
.env
*.pem
*.p8
terraform.tfstate*
.terraform/

# dbt's build output and logs
warehouse/dbt/target/
warehouse/dbt/logs/

# Pipeline outputs (fixtures/ is committed; runs/ is regenerated)
runs/

# Downloaded source files (about 1 GB per month; tracked by loader/sources.lock) and the
# offline sample cut from them (tracked by loader/sample.lock)
data/
.hypothesis/

# What a killed pilot process leaves in a pass's committed directory: a write's
# temporary file, or a dbt manifest's staging copy
fixtures/pilot/**/*.tmp-*
fixtures/pilot/**/.tmp-*/
